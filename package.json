{
  "name": "monjtv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently -k \"vite\" \"tsx watch src/server/index.ts\"",
    "build": "vite build",
    "start:server": "tsx src/server/index.ts",
    "start": "npm run build && npm run start:server",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "desktop": "node scripts/install-desktop.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@preact/preset-vite": "^2.10.6",
    "tsx": "^4.23.15",
    "vite": "^8.3.4"
  }
}
